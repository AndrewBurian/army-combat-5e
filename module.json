{
  "id": "army-combat-5e",
  "title": "Army Combat 5e",
  "description": "Army-scale combat for D&D 5e, implementing the Unearthed Arcana <em>When Armies Clash</em> playtest. Adds Stand and Unit actor types.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.0",
          "verified": "5.3.3"
        }
      }
    ]
  },
  "authors": [
    {
      "name": "Andrew Burian"
    }
  ],
  "esmodules": [
    "scripts/army-combat-5e.mjs"
  ],
  "styles": [
    "styles/army-combat-5e.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "stand": {
        "htmlFields": ["details.biography.value", "details.biography.public"]
      },
      "unit": {
        "htmlFields": ["description.full", "description.summary"]
      }
    }
  },
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang"]
    }
  },
  "socket": false,
  "url": "https://github.com/AndrewBurian/army-combat-5e",
  "manifest": "https://github.com/AndrewBurian/army-combat-5e/releases/latest/download/module.json",
  "download": "https://github.com/AndrewBurian/army-combat-5e/archive/refs/heads/main.zip"
}
