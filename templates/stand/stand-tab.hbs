<section class="tab army-stand-tab {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">

  {{#unless stand.hasValidSize}}
  <div class="notification warning">{{localize "ARMY5E.Stand.Warning.SizeOnSheet"}}</div>
  {{/unless}}

  {{#if stand.isCasualty}}
  <div class="notification warning">{{localize "ARMY5E.Stand.CasualtyNotice"}}</div>
  {{/if}}

  <fieldset>
    <legend>{{localize "ARMY5E.Stand.Composition"}}</legend>

    <div class="form-group">
      <label>{{localize "ARMY5E.Stand.FiguresStanding"}}</label>
      <div class="form-fields">
        <span class="army-figures">{{stand.figuresStanding}} / {{stand.creaturesPerStand}}</span>
      </div>
      <p class="hint">{{localize "ARMY5E.Stand.FiguresStandingHint"}}</p>
    </div>

    {{#if stand.origin}}
    <div class="form-group">
      <label>{{localize "ARMY5E.Stand.Origin"}}</label>
      <div class="form-fields">
        <a class="content-link" data-uuid="{{stand.origin.uuid}}">
          <img src="{{stand.origin.img}}" alt="{{stand.origin.name}}" width="20" height="20">
          {{stand.origin.name}}
        </a>
      </div>
      <p class="hint">{{localize "ARMY5E.Stand.OriginHint"}}</p>
    </div>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize "ARMY5E.Stand.Scaling"}}</legend>
    <p class="hint">{{localize "ARMY5E.Stand.ScalingHint"}}</p>

    <div class="form-group">
      <label for="{{id}}-scaling-hp">{{localize "ARMY5E.Stand.ScalingHP"}}</label>
      <div class="form-fields">
        <input type="number" id="{{id}}-scaling-hp" name="system.stand.scaling.hp"
               value="{{stand.scaling.hp}}" min="0" step="0.5" {{#unless editable}}disabled{{/unless}}>
      </div>
    </div>

    <div class="form-group">
      <label for="{{id}}-scaling-damage">{{localize "ARMY5E.Stand.ScalingDamage"}}</label>
      <div class="form-fields">
        <input type="number" id="{{id}}-scaling-damage" name="system.stand.scaling.damage"
               value="{{stand.scaling.damage}}" min="0" step="0.5" {{#unless editable}}disabled{{/unless}}>
      </div>
    </div>

    {{#if stand.isModified}}
    <p class="hint warning">{{localize "ARMY5E.Stand.ScalingModified"}}</p>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize "ARMY5E.Stand.Solos"}}</legend>
    <p class="hint">{{localize "ARMY5E.Stand.SolosHint"}}</p>

    {{#if stand.solos.length}}
    <ul class="army-solo-list unlist">
      {{#each stand.solos}}
      <li class="army-solo" data-uuid="{{this.uuid}}">
        <img src="{{this.img}}" alt="{{this.name}}" width="32" height="32">
        <a class="content-link" data-uuid="{{this.uuid}}">{{this.name}}</a>
        {{#if @root.editable}}
        <button type="button" class="unbutton" data-action="removeSolo"
                data-tooltip="ARMY5E.Stand.RemoveSolo" aria-label="{{localize 'ARMY5E.Stand.RemoveSolo'}}">
          <i class="fas fa-times"></i>
        </button>
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="empty">{{localize "ARMY5E.Stand.NoSolos"}}</p>
    {{/if}}
  </fieldset>

</section>
